{
  "tasks_dir": "tasks",

  "model_under_test": {
    "provider": "auto",
    "model": "your-model-name",
    "base_url": "https://api.example.com/v1",
    "api_key_env": "MODEL_API_KEY",
    "temperature": 0.7,
    "max_tokens": 4096,
    "timeout": 120,
    "stream": false
  },

  "judge": {
    "provider": "auto",
    "model": "your-judge-model-name",
    "base_url": "https://api.example.com/v1",
    "api_key_env": "JUDGE_API_KEY",
    "temperature": 0.0,
    "max_tokens": 2048,
    "timeout": 120
  }
}
