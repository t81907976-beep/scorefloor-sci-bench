# Results / 运行产物
results/

# 跑测日志（含本机路径与逐 run 原文，纯运行时产物）
logs/

# 逐 run 续跑缓存（--resume 的落盘目录，纯运行时产物）
.bench-cache/

# 后台任务日志（心跳/耗时/告警，纯运行时产物，含本机路径线索）
logs/

# 本地配置（含端点/密钥线索），只提交 config.example.json
config.json

# 密钥（含 API Token，绝不提交）
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# 本地 IDE 多根工作区文件（含本机绝对路径）
*.code-workspace

# 评分报告与工作记录（本地产物，不随代码提交）
reports/
